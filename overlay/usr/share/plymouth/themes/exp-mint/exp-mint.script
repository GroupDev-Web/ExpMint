Window.SetBackgroundTopColor(0.025, 0.055, 0.043);
Window.SetBackgroundBottomColor(0.01, 0.018, 0.016);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 18);

fun refresh_callback () {
  progress = Plymouth.GetBootProgress();
  width = Math.Int(Window.GetWidth() * 0.22 * progress);
  bar.image = Image.Text("────────────────", 0.22, 0.86, 0.55);
  bar.sprite = Sprite(bar.image);
  bar.sprite.SetX(Window.GetWidth() / 2 - bar.image.GetWidth() / 2);
  bar.sprite.SetY(Window.GetHeight() / 2 + 125);
  bar.sprite.SetOpacity(0.35 + progress * 0.65);
}

Plymouth.SetRefreshFunction(refresh_callback);
